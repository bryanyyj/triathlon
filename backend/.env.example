# Strava API credentials.
# Create an API app at https://www.strava.com/settings/api to get a Client ID/Secret.
# Once these are set, click "Connect Strava" in the app to authorize and store a refresh
# token automatically (or run `npm run strava:auth` for a one-off CLI flow).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

PORT=3001
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenRouter AI Coach (Phase 16) - leave blank to keep the coach disabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Coach chat bubble (backend/coach). It only calls ":free" models unless you allow paid ones,
# so either use a free slug above (e.g. nvidia/nemotron-3-ultra-550b-a55b:free) or set this to true.
# OPENROUTER_ALLOW_PAID=false

# Max heart rate for HR zones. Leave blank to estimate it from your activities (sensor spikes are ignored).
# MAX_HR=

# Hidden reasoning before the coach replies: off (default, fastest), on, or a token cap like 1000.
# OPENROUTER_REASONING=off
